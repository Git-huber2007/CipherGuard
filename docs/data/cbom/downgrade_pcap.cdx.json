    {
      "bom-ref": "crypto:78e0df37b2bd5195",
      "id": "IKE-006",
      "source": {
        "name": "CipherGuard"
      },
      "ratings": [
        {
          "severity": "critical",
          "method": "other"
        }
      ],
      "description": "Prohibited Diffie-Hellman group 2 (1024-bit MODP)",
      "detail": "1024-bit MODP: within reach of nation-state precomputation (Logjam). A single precomputation against a standard modulus breaks every session that ever used it, including traffic already recorded.",
      "recommendation": "Configure Group 19 (256-bit ECP) or Group 14 at minimum.",
      "properties": [
        {
          "name": "cipherguard:provenance",
          "value": "observed"
        },
        {
          "name": "cipherguard:reference",
          "value": "RFC 8247 s2.4; NIST SP 800-77 Rev. 1 s3.3"
        }
      ]
    },
    {
      "bom-ref": "crypto:8ba463f67f159673",
      "id": "IKE-012",
      "source": {
        "name": "CipherGuard"
      },
      "ratings": [
        {
          "severity": "high",
          "method": "other"
        }
      ],
      "description": "Association provides only 80-bit security",
      "detail": "Component strengths: encryption 128 bits, prf 96 bits, integrity 96 bits, key_exchange 80 bits. The association is bounded by its key_exchange at 80 bits, which is graded 'deprecated'. A strong cipher does not compensate for a weak key exchange: an attacker who recovers the session key never has to attack the cipher at all.",
      "recommendation": "Raise the key_exchange to at least the 128-bit level. The whole suite should be re-specified together rather than patched component by component.",
      "properties": [
        {
          "name": "cipherguard:provenance",
          "value": "observed"
        },
        {
          "name": "cipherguard:reference",
          "value": "NIST SP 800-57 Part 1 Rev. 5, Table 2"
        }
      ]
    }
  ]
