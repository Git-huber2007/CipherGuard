# CipherGuard reads these from the environment. None is needed for the default
# local run (`cipherguard serve` on 127.0.0.1 with no token).
#
# Nothing loads this file automatically. Copy it to .env, fill it in, and
# export the values in your shell or pass the file to your process manager
# (docker run --env-file .env, systemd EnvironmentFile=, Render's dashboard).
# .env is gitignored; never commit a real token.

# Access token the API requires in "Authorization: Bearer <token>".
# Required for any bind other than loopback. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
CIPHERGUARD_TOKEN=

# Web origins allowed to call the API from a browser, comma-separated.
# Only needed when the dashboard page is served from somewhere else,
# for example the static build on GitHub Pages. A wildcard is rejected.
# CIPHERGUARD_CORS_ORIGINS=https://example.github.io

# Extra host names the server answers to when no token is set, comma-separated.
# Without a token only 127.0.0.1, localhost and ::1 are answered.
# CIPHERGUARD_ALLOWED_HOSTS=tunnel.example

# Set to 1 to let the Wi-Fi view ask a public service for this machine's
# public address and ISP. Off by default: the tool makes no outbound calls.
# CIPHERGUARD_EGRESS_LOOKUP=0

# Port for `cipherguard serve` when --port is not given.
# PORT=8000
